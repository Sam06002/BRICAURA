# Application Environment Configuration
APP_ENV=development
APP_NAME="Real Estate Lead Management CRM"
LOG_LEVEL=INFO
APP_HOST=127.0.0.1
APP_PORT=8000

# Google Sheets Persistence Configuration
GOOGLE_SHEETS_SPREADSHEET_ID=your_spreadsheet_id_here
GOOGLE_SHEETS_WORKSHEET_NAME=RawLeads
GOOGLE_SHEETS_REVIEWED_WORKSHEET_NAME=ReviewedLeads

# Service Account Authentication (use file path OR JSON string)
GOOGLE_SERVICE_ACCOUNT_FILE=credentials/service_account.json
# GOOGLE_SERVICE_ACCOUNT_INFO={"type": "service_account", ...}

# Reddit API credentials (required to collect Reddit posts)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=BRICAURA/0.1 local lead review tool

# Facebook Page feed access (Meta Groups API is no longer available)
# Use a Meta token with read access for each listed Page.
META_ACCESS_TOKEN=
FACEBOOK_PAGE_IDS=
META_GRAPH_API_VERSION=v26.0

# Telegram user API (required to search configured groups' recent history)
# Create API credentials at https://my.telegram.org and authorize once with:
# python -m app.telegram_login
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_GROUPS=@your_group_one,@your_group_two
TELEGRAM_SESSION=credentials/bricaura_telegram

# Local review queue database
BRICAURA_DATABASE_PATH=data/bricaura.sqlite3
